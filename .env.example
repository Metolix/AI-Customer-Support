# Required
GROQ_API_KEY=your_groq_api_key_here

# Recommended production model. Override if you want another supported Groq model.
GROQ_MODEL=openai/gpt-oss-20b

# Business knowledge source
COMPANY_INFO_FILE=data/company_info.txt

# Comma-separated browser origins allowed to call this API.
# Example: https://example.com,https://www.example.com
CORS_ORIGINS=http://localhost:8000

# Per-client API rate limit
RATE_LIMIT=30/minute

# Request limits
MAX_MESSAGE_LENGTH=2000
MAX_HISTORY_MESSAGES=10
MAX_HISTORY_MESSAGE_LENGTH=4000

# Optional additional prompt-guard model.
# Direct input checks remain enabled regardless.
ENABLE_PROMPT_GUARD=false
